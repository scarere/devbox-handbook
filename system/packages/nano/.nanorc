# Syntax Highlighting
# ============================================================

# Include syntax files from homebrew nano
include "/opt/homebrew/share/nano/*.nanorc"

# Include extended syntax files (github.com/galenguyer/nano-syntax-highlighting)
include "~/.nano/*.nanorc"

# Custom nanorc file for kitty config
#include "~/.config/kitty/kitty.nanorc"

# Settings
# ============================================================

# Display
set constantshow  # Show current line/column at the bottom
set indicator     # Scroll position indicator on the right

# Tabs
set tabsize 4     # 4-space tabs
set tabstospaces  # Use spaces instead of tab characters

# Editing
set autoindent    # Match indentation of previous line
set zap           # Allow replacing/deleting selected text

# Mouse
set mouse         # Enable mouse click to place cursor
